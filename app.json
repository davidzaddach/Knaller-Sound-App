{
  "expo": {
    "name": "Knaller Sound App",
    "slug": "knaller-sound-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-512.png",
    "userInterfaceStyle": "dark",
    "scheme": "knallersoundapp",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0f"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.knaller.soundapp",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "spotify",
          "instagram",
          "tiktok",
          "youtube",
          "linkedin"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/images/favicon-32.png",
      "name": "Knaller Sound App",
      "shortName": "Knaller",
      "description": "Reggae & Dancehall Soundboard App",
      "backgroundColor": "#0a0a0f",
      "themeColor": "#ff2d95",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ]
  }
}
